# Benchmarks & Profiler Artefacts
*.prof
.coverage
htmlcov/
.pytest_cache/

# Environments & Dependencies
.env
.venv
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
