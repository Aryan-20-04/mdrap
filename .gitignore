# ==============================================================================
# MDRAP (Market Data Reliability & Acceleration Platform) - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# C / Native Build Artifacts & Intermediate Objects
*.o
*.obj
*.so
*.dylib
*.a
*.lib
*.exp
# Note: src/fastpath.dll is tracked as a precompiled baseline; ignore temporary builds
build/
dist/
bin/
obj/
*.egg-info/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Local Secrets
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Profiling & Diagnostics
*.prof
*.pstats

# SQLite Databases & Ephemeral Market Data
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/raw_archive/
!data/.gitkeep

# DuckDB & Columnar Parquet Data
data/*.duckdb
data/*.duckdb.wal
data/parquet/*
!data/parquet/.gitkeep
*.duckdb
*.parquet

# Generated Reports & Financial Exports
data/reports/*
!data/reports/.gitkeep
*.xlsx
*.csv

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Temporary & Scratch Files
scratch/
tmp/
*.tmp
*.log

# Packaging & Distribution
dist/
*.egg-info/
src/*.egg-info/
*.whl
*.tar.gz

# CHD historical caches and published research runs
data/chd-cache/
data/chd-runs/

# SEC EDGAR cache
data/edgar_cache/
