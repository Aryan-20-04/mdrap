# ==============================================================================
# MDRAP Core Commercial Environment Configuration Template
# ==============================================================================
#
# IMPORTANT DATA LICENSING NOTICE:
# MDRAP is a software-only infrastructure platform for market data quality,
# cross-feed reconciliation, latency acceleration, and cryptographic auditing.
# MDRAP DOES NOT PROVIDE, RESELL, BROKER, OR SUBLICENSE MARKET DATA.
#
# Licensees and deploying organizations are solely responsible for securing,
# maintaining, and complying with all direct commercial licenses, vendor
# agreements, redistribution contracts, and exchange policies required by their
# respective data vendors (e.g., Polygon.io, Databento, CME Group, Nasdaq, OPRA,
# ICE, Cboe, or cryptocurrency exchange APIs).
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Server Configuration
# ------------------------------------------------------------------------------
MDRAP_HOST=0.0.0.0
MDRAP_PORT=8000
MDRAP_DB_PATH=/data/mdrap.db
MDRAP_CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Security & RBAC Bootstrap
# ------------------------------------------------------------------------------
# Set this to initialize a designated master ADMIN API key upon first database setup.
# If left blank, MDRAP automatically generates a cryptographically random admin key
# upon initial startup and displays it once in the initialization log.
# Format: string (minimum 16 characters recommended)
MDRAP_INITIAL_ADMIN_KEY=

# ------------------------------------------------------------------------------
# 3. Optional TLS Reverse Proxy (Caddy)
# ------------------------------------------------------------------------------
# Used when running `docker compose --profile tls up -d`
DOMAIN=localhost

# ------------------------------------------------------------------------------
# 4. Direct Market Data Feed Credentials (Licensed by Customer)
# ------------------------------------------------------------------------------
# Populate with credentials from feeds you license directly.

# Polygon.io Direct Equities / Options / Forex Feed
POLYGON_API_KEY=

# Databento Institutional Futures / Equities Feed
DATABENTO_API_KEY=

# Coinbase Pro Direct WebSocket Market Feed
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Binance Direct WebSocket Market Feed
BINANCE_API_KEY=
BINANCE_API_SECRET=
