include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include setup.py
include build_fastpath.py
include config.yaml
include pytest.ini
include mdrap
include mdrap.bat

recursive-include src *.py *.c *.h *.dll *.so *.dylib
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *.py *.ipynb
recursive-include personas *.py

global-exclude *.py[cod] __pycache__ *.o *.obj
global-exclude *.prof *.pstats *.coverage *.tmp *.db *.duckdb *.parquet
prune dist
prune build
prune scratch
prune .pytest_cache
